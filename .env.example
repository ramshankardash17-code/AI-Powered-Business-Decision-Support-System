# Enterprise AI Business Decision Intelligence Platform
# Environment Configuration Template

# Database Settings
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_bi
# Set to true to automatically fallback to SQLite if PostgreSQL is unavailable
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=data/ecommerce_bi.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE="Enterprise AI Decision Intelligence Platform"
API_VERSION="1.0.0"
DEBUG=true

# LLM & AI Keys (Optional: system provides deterministic smart heuristics/mock fallback when no key is present)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=mock_heuristic  # options: mock_heuristic, openai, gemini

# ML & Monitoring
ML_MODELS_DIR=data/models
DATA_QUALITY_THRESHOLD=85.0
DRIFT_ALERT_THRESHOLD=0.15

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:8000"]
